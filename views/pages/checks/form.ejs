<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="icon" type="image/x-icon" href="/ico/favicon.ico">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/portal.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
</head>
<body>
    <div class="grid-bg"></div>
    
    <div class="portal-container">
        <%- include('../../partials/sidebar', { user: user, activePage: activePage, permissions: permissions }) %>
        
        <div class="portal-content">
            <header class="portal-header">
                <h1><%= isEdit ? '✏️ Редактирование чека' : '➕ Создание чека' %></h1>
                <a href="/checks" class="btn btn-outline">← Назад к списку</a>
            </header>

            <div class="form-container">
                <form action="/checks/save" method="POST" id="checkForm">
                    <% if (isEdit && check) { %>
                        <input type="hidden" name="id" value="<%= check.id %>">
                    <% } %>

                    <div class="form-group">
                        <label for="clientName">Имя клиента *</label>
                        <input type="text" id="clientName" name="clientName" 
                               class="form-input"
                               value="<%= check ? check.clientName : '' %>" 
                               placeholder="Введите имя клиента" required>
                    </div>

                    <div class="form-group">
                        <label for="phone">Телефон</label>
                        <input type="text" id="phone" name="phone" 
                               class="form-input"
                               value="<%= check ? check.phone : '' %>" 
                               placeholder="+7 (999) 123-45-67">
                    </div>

                    <div class="form-group">
                        <label for="serviceId">Услуга *</label>
                        <select id="serviceId" name="serviceId" class="form-select" required>
                            <option value="">Выберите услугу</option>
                            <% if (services && services.length > 0) { %>
                                <% services.forEach(service => { %>
                                    <option value="<%= service.id %>" 
                                        <%= (check && check.serviceId === service.id) ? 'selected' : '' %>>
                                        <%= service.name %> — <%= service.price %>
                                    </option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="amount">Сумма (₽) *</label>
                        <input type="number" id="amount" name="amount" 
                               class="form-input"
                               value="<%= check ? check.amount : '' %>" 
                               placeholder="Введите сумму" required step="0.01" min="0">
                    </div>

                    <div class="form-group">
                        <label for="paymentMethod">Метод оплаты</label>
                        <select id="paymentMethod" name="paymentMethod" class="form-select">
                            <option value="Наличные" <%= (check && check.paymentMethod === 'Наличные') ? 'selected' : '' %>>Наличные</option>
                            <option value="Карта" <%= (check && check.paymentMethod === 'Карта') ? 'selected' : '' %>>Карта</option>
                            <option value="Перевод" <%= (check && check.paymentMethod === 'Перевод') ? 'selected' : '' %>>Перевод</option>
                            <option value="Бонусы" <%= (check && check.paymentMethod === 'Бонусы') ? 'selected' : '' %>>Бонусы</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="status">Статус</label>
                        <select id="status" name="status" class="form-select">
                            <option value="Оплачен" <%= (check && check.status === 'Оплачен') ? 'selected' : '' %>>Оплачен</option>
                            <option value="Черновик" <%= (check && check.status === 'Черновик') ? 'selected' : '' %>>Черновик</option>
                            <option value="Отменен" <%= (check && check.status === 'Отменен') ? 'selected' : '' %>>Отменен</option>
                        </select>
                    </div>

                    <div class="form-actions">
                        <a href="/checks" class="btn btn-outline">Отмена</a>
                        <button type="submit" class="btn btn-primary" id="saveBtn">
                            <%= isEdit ? '💾 Сохранить' : '✅ Создать чек' %>
                        </button>
                        <% if (!isEdit) { %>
                            <button type="button" class="btn btn-primary" onclick="createAndPrint()" style="background: var(--accent2);">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 0.3rem;">
                                    <polyline points="6 9 6 2 18 2 18 9"/>
                                    <path d="M18 9H6M18 9V16H6V9M18 16H22V12H18M6 16H2V12H6"/>
                                    <rect x="8" y="13" width="8" height="4" rx="1"/>
                                </svg>
                                Создать и распечатать
                            </button>
                        <% } %>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Модальное окно для печати чека -->
    <div class="modal-overlay" id="printModal">
        <div class="modal" style="max-width: 500px;">
            <button class="modal-close" onclick="closePrintModal()">×</button>
            <h3 style="text-align: center; font-family: 'Space Grotesk', sans-serif;">🧾 Чек</h3>
            <div id="printContent" style="padding: 1rem 0;"></div>
            <div style="display: flex; gap: 0.5rem; justify-content: center; margin-top: 1rem; flex-wrap: wrap;">
                <button onclick="downloadPDF()" class="btn btn-primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 0.3rem;">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                        <polyline points="7 10 12 15 17 10"/>
                        <line x1="12" y1="15" x2="12" y2="3"/>
                    </svg>
                    Скачать PDF
                </button>
                <button onclick="window.print()" class="btn btn-outline">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 0.3rem;">
                        <polyline points="6 9 6 2 18 2 18 9"/>
                        <path d="M18 9H6M18 9V16H6V9M18 16H22V12H18M6 16H2V12H6"/>
                        <rect x="8" y="13" width="8" height="4" rx="1"/>
                    </svg>
                    Распечатать
                </button>
                <button onclick="closePrintModal()" class="btn btn-outline">Закрыть</button>
            </div>
        </div>
    </div>

    <script src="/js/portal.js"></script>
    <script>
        let lastCreatedCheck = null;

        // Создать и распечатать
        function createAndPrint() {
            const form = document.getElementById('checkForm');
            const formData = new FormData(form);
            
            // Проверяем обязательные поля
            const clientName = document.getElementById('clientName').value.trim();
            const serviceId = document.getElementById('serviceId').value;
            const amount = document.getElementById('amount').value;
            
            if (!clientName || !serviceId || !amount) {
                alert('Заполните все обязательные поля: Имя клиента, Услуга, Сумма');
                return;
            }

            // Отправляем форму
            fetch('/checks/save', {
                method: 'POST',
                body: formData
            })
            .then(response => {
                if (response.redirected) {
                    // Получаем ID созданного чека из URL редиректа
                    const url = response.url;
                    return fetch(url)
                        .then(res => res.text())
                        .then(html => {
                            // Извлекаем данные чека из страницы
                            const parser = new DOMParser();
                            const doc = parser.parseFromString(html, 'text/html');
                            const rows = doc.querySelectorAll('.portal-table tbody tr');
                            if (rows.length > 0) {
                                const lastRow = rows[rows.length - 1];
                                const idBadge = lastRow.querySelector('.id-badge');
                                // Находим чек в checksData
                                const checksData = <%= JSON.stringify(checks) %>;
                                // Получаем последний созданный чек
                                return fetch('/checks')
                                    .then(res => res.text())
                                    .then(html => {
                                        const doc2 = parser.parseFromString(html, 'text/html');
                                        const rows2 = doc2.querySelectorAll('.portal-table tbody tr');
                                        if (rows2.length > 0) {
                                            const lastRow2 = rows2[rows2.length - 1];
                                            const editBtn = lastRow2.querySelector('a[href*="/edit"]');
                                            if (editBtn) {
                                                const href = editBtn.getAttribute('href');
                                                const id = href.split('/')[2];
                                                // Находим чек по ID
                                                const check = checksData.find(c => c.id === id);
                                                if (check) {
                                                    lastCreatedCheck = check;
                                                    printCheck(check.id);
                                                }
                                            }
                                        }
                                    });
                            }
                        });
                }
                return response.json();
            })
            .catch(err => {
                alert('Ошибка при создании чека: ' + err.message);
            });
        }

        // Печать чека
        function printCheck(id) {
            const checksData = <%= JSON.stringify(checks) %>;
            const checkData = checksData.find(c => c.id === id) || lastCreatedCheck;
            
            if (!checkData) {
                alert('Чек не найден');
                return;
            }

            const content = document.getElementById('printContent');
            content.innerHTML = `
                <div style="text-align: center; margin-bottom: 1.5rem; padding: 1rem; background: var(--surface); border-radius: var(--radius); border: 1px solid var(--border);">
                    <h2 style="font-family: 'Space Grotesk', sans-serif; color: var(--accent); font-size: 1.5rem;">DEEP GAZE</h2>
                    <p style="color: var(--text-secondary); font-size: 0.8rem;">Студия макросъемки радужки глаза</p>
                    <hr style="border: none; border-top: 1px solid var(--border); margin: 1rem 0;">
                </div>
                <div style="text-align: left; font-size: 0.9rem; padding: 0 0.5rem;">
                    <p><strong>№ чека:</strong> #${checkData.id.substr(0, 8)}</p>
                    <p><strong>Клиент:</strong> ${checkData.clientName || 'Не указан'}</p>
                    <p><strong>Телефон:</strong> ${checkData.phone || '—'}</p>
                    <p><strong>Услуга:</strong> ${checkData.serviceName || 'Не указана'}</p>
                    <p><strong>Сумма:</strong> <span style="color: var(--accent); font-weight: 700; font-size: 1.2rem;">${(checkData.amount || 0).toLocaleString()} ₽</span></p>
                    <p><strong>Метод оплаты:</strong> ${checkData.paymentMethod || '—'}</p>
                    <p><strong>Статус:</strong> ${checkData.status || 'Черновик'}</p>
                    <p><strong>Дата:</strong> ${new Date(checkData.createdAt).toLocaleDateString('ru-RU', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' })}</p>
                    ${checkData.branchName ? `<p><strong>Филиал:</strong> ${checkData.branchName}</p>` : ''}
                    <p><strong>Менеджер:</strong> ${checkData.createdBy || '—'}</p>
                </div>
                <hr style="border: none; border-top: 1px solid var(--border); margin: 1rem 0;">
                <div style="text-align: center; color: var(--text-muted); font-size: 0.7rem; padding: 0.5rem;">
                    <p>Спасибо за выбор DEEP GAZE!</p>
                    <p>www.deepgaze.ru</p>
                </div>
            `;

            document.getElementById('printModal').classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        // Закрыть модальное окно
        function closePrintModal() {
            document.getElementById('printModal').classList.remove('active');
            document.body.style.overflow = '';
            // Если был создан новый чек, перезагружаем страницу
            if (lastCreatedCheck) {
                location.reload();
            }
        }

        // Скачать PDF
        function downloadPDF() {
            const element = document.getElementById('printContent');
            const opt = {
                margin:        [10, 10, 10, 10],
                filename:      `чек_${(lastCreatedCheck || {}).id ? lastCreatedCheck.id.substr(0, 8) : 'new'}.pdf`,
                image:         { type: 'jpeg', quality: 0.98 },
                html2canvas:   { scale: 2, useCORS: true, backgroundColor: '#0a0c12' },
                jsPDF:         { unit: 'mm', format: 'a5', orientation: 'portrait' },
                pagebreak:     { mode: ['avoid-all', 'css', 'legacy'] }
            };
            
            html2pdf().set(opt).from(element).save();
        }

        // Закрытие модального окна по клику на оверлей
        document.getElementById('printModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closePrintModal();
            }
        });

        // Закрытие по Esc
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closePrintModal();
            }
        });
    </script>

    <style>
        /* Стили для форм в стиле сайта */
        .form-container {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 2rem;
            max-width: 600px;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-group label {
            display: block;
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text-secondary);
            margin-bottom: 0.4rem;
            letter-spacing: 0.02em;
        }

        .form-input,
        .form-select {
            width: 100%;
            padding: 0.7rem 1rem;
            border-radius: 0.5rem;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border);
            color: var(--text);
            font-family: 'Inter', sans-serif;
            font-size: 0.9rem;
            transition: var(--transition);
            outline: none;
        }

        .form-input:focus,
        .form-select:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(200, 164, 92, 0.1);
        }

        .form-input::placeholder {
            color: var(--text-muted);
        }

        .form-select option {
            background: var(--surface);
            color: var(--text);
        }

        .form-actions {
            display: flex;
            gap: 1rem;
            margin-top: 1.5rem;
            flex-wrap: wrap;
        }

        .form-actions .btn {
            flex: 1;
            justify-content: center;
            min-width: 120px;
        }

        /* Стили для модального окна печати */
        #printContent {
            background: var(--surface);
            padding: 1.5rem;
            border-radius: var(--radius);
            border: 1px solid var(--border);
            max-width: 100%;
            margin: 0 auto;
        }

        #printContent p {
            margin: 0.4rem 0;
            color: var(--text-secondary);
        }

        #printContent p strong {
            color: var(--text);
        }

        .modal-overlay .modal {
            max-width: 500px;
        }

        @media print {
            .portal-sidebar,
            .portal-header .portal-actions,
            .actions-cell,
            .btn,
            .modal-close,
            .modal-overlay .modal .btn,
            .sidebar-toggle,
            .grid-bg,
            .form-actions {
                display: none !important;
            }

            .modal-overlay {
                position: fixed !important;
                background: white !important;
                backdrop-filter: none !important;
                opacity: 1 !important;
                pointer-events: all !important;
                top: 0 !important;
                left: 0 !important;
                right: 0 !important;
                bottom: 0 !important;
                z-index: 9999 !important;
            }

            .modal-overlay .modal {
                background: white !important;
                border: none !important;
                box-shadow: none !important;
                max-width: 100% !important;
                width: 100% !important;
                padding: 2rem !important;
                border-radius: 0 !important;
                max-height: 100vh !important;
                overflow-y: auto !important;
            }

            .modal-overlay .modal h3 {
                color: #000 !important;
            }

            #printContent {
                background: white !important;
                border: 1px solid #e0e0e0 !important;
                color: #000 !important;
            }

            #printContent p,
            #printContent p strong {
                color: #000 !important;
            }

            #printContent .accent {
                color: #c8a45c !important;
            }

            #printContent h2 {
                color: #c8a45c !important;
            }

            body * {
                visibility: hidden;
            }
            #printModal,
            #printModal * {
                visibility: visible;
            }
            #printModal {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
            }
        }

        @media (max-width: 768px) {
            .form-container {
                padding: 1.2rem;
            }
            
            .form-actions {
                flex-direction: column;
            }
            
            .form-actions .btn {
                width: 100%;
            }
        }
    </style>
</body>
</html>
