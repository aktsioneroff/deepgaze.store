<%- include('../../partials/header', { user: user }) %>

<div class="portal-container">
    <%- include('../../partials/sidebar', { user: user, activePage: '/checks', permissions: permissions }) %>
    
    <main class="portal-content">
        <div class="page-header">
            <h1><%= isEdit ? '✏️ Редактирование чека' : '➕ Создание чека' %></h1>
            <a href="/checks" class="btn btn-outline">← Назад</a>
        </div>

        <div class="form-container">
            <form action="/checks/save" method="POST">
                <% if (isEdit && check) { %>
                    <input type="hidden" name="id" value="<%= check.id %>">
                <% } %>

                <div class="form-group">
                    <label>Имя клиента *</label>
                    <input type="text" name="clientName" class="form-control" 
                           value="<%= check ? check.clientName : '' %>" required>
                </div>

                <div class="form-group">
                    <label>Телефон</label>
                    <input type="text" name="phone" class="form-control" 
                           value="<%= check ? check.phone : '' %>" placeholder="+7 (999) 123-45-67">
                </div>

                <div class="form-group">
                    <label>Услуга *</label>
                    <select name="serviceId" class="form-control" required>
                        <option value="">Выберите услугу</option>
                        <% if (services && services.length > 0) { %>
                            <% services.forEach(service => { %>
                                <option value="<%= service.id %>" 
                                    <%= (check && check.serviceId === service.id) ? 'selected' : '' %>>
                                    <%= service.name %> — <%= service.price %>
                                </option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>

                <div class="form-group">
                    <label>Сумма (₽) *</label>
                    <input type="number" name="amount" class="form-control" 
                           value="<%= check ? check.amount : '' %>" required step="0.01" min="0">
                </div>

                <div class="form-group">
                    <label>Метод оплаты</label>
                    <select name="paymentMethod" class="form-control">
                        <option value="Наличные" <%= (check && check.paymentMethod === 'Наличные') ? 'selected' : '' %>>Наличные</option>
                        <option value="Карта" <%= (check && check.paymentMethod === 'Карта') ? 'selected' : '' %>>Карта</option>
                        <option value="Перевод" <%= (check && check.paymentMethod === 'Перевод') ? 'selected' : '' %>>Перевод</option>
                        <option value="Бонусы" <%= (check && check.paymentMethod === 'Бонусы') ? 'selected' : '' %>>Бонусы</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Статус</label>
                    <select name="status" class="form-control">
                        <option value="Оплачен" <%= (check && check.status === 'Оплачен') ? 'selected' : '' %>>Оплачен</option>
                        <option value="Черновик" <%= (check && check.status === 'Черновик') ? 'selected' : '' %>>Черновик</option>
                        <option value="Отменен" <%= (check && check.status === 'Отменен') ? 'selected' : '' %>>Отменен</option>
                    </select>
                </div>

                <div class="form-actions">
                    <a href="/checks" class="btn btn-outline">Отмена</a>
                    <button type="submit" class="btn btn-primary">
                        <%= isEdit ? '💾 Сохранить' : '✅ Создать' %>
                    </button>
                </div>
            </form>
        </div>
    </main>
</div>

<%- include('../../partials/footer') %>
