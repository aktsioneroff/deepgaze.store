<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="icon" type="image/x-icon" href="/ico/favicon.ico">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/portal.css">
</head>
<body>
    <div class="grid-bg"></div>
    
    <div class="portal-container">
        <%- include('../../partials/sidebar', { user: user, activePage: activePage }) %>
        
        <div class="portal-content">
            <header class="portal-header">
                <h1>💳 Чеки</h1>
                <div class="portal-actions">
                    <% if (permissions && permissions.checks && permissions.checks.create) { %>
                        <a href="/checks/new" class="btn btn-primary">+ Создать чек</a>
                    <% } %>
                </div>
            </header>

            <div class="portal-stats">
                <div class="stat-card">
                    <div class="stat-number"><%= checks.length %></div>
                    <div class="stat-label">Всего чеков</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">
                        <% 
                            let total = 0;
                            checks.forEach(c => { total += (c.total || c.amount || 0); });
                        %>
                        <%= total.toLocaleString() %> ₽
                    </div>
                    <div class="stat-label">Общая сумма</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">
                        <% 
                            let paidCount = checks.filter(c => c.status === 'Оплачен').length;
                        %>
                        <%= paidCount %>
                    </div>
                    <div class="stat-label">Оплачено</div>
                </div>
            </div>

            <div class="portal-table-wrapper">
                <table class="portal-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Клиент</th>
                            <th>Услуга</th>
                            <th>Цена</th>
                            <th>Итого</th>
                            <th>Метод</th>
                            <th>Статус</th>
                            <th>Дата</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (checks && checks.length > 0) { %>
                            <% checks.forEach(check => { %>
                                <tr>
                                    <td><span class="id-badge">#<%= shortId ? shortId(check.id) : check.id.substr(0, 8) %></span></td>
                                    <td><strong><%= check.clientName || check.client || 'Не указан' %></strong></td>
                                    <td><%= check.serviceName || 'Не указана' %></td>
                                    <td><%= (check.servicePrice || 0).toLocaleString() %> ₽</td>
                                    <td><span class="check-total"><%= (check.total || check.amount || 0).toLocaleString() %> ₽</span></td>
                                    <td><%= check.paymentMethod || 'Не указан' %></td>
                                    <td>
                                        <span class="status-badge status-<%= (check.status || 'черновик').toLowerCase() %>">
                                            <%= check.status || 'Черновик' %>
                                        </span>
                                    </td>
                                    <td><%= new Date(check.createdAt).toLocaleDateString('ru-RU') %></td>
                                    <td class="actions-cell">
                                        <% if (permissions && permissions.checks && permissions.checks.edit) { %>
                                            <a href="/checks/<%= check.id %>/edit" class="btn-icon" title="Редактировать">✏️</a>
                                        <% } %>
                                        <% if (permissions && permissions.checks && permissions.checks.delete) { %>
                                            <button onclick="deleteCheck('<%= check.id %>')" class="btn-icon" title="Удалить">🗑️</button>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="9" class="empty-state">
                                    <div class="empty-icon">📭</div>
                                    <p>Нет созданных чеков</p>
                                    <% if (permissions && permissions.checks && permissions.checks.create) { %>
                                        <a href="/checks/new" class="btn btn-primary">Создать первый чек</a>
                                    <% } %>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="/js/portal.js"></script>
    <script>
        function deleteCheck(id) {
            if (confirm('Вы уверены, что хотите удалить этот чек?')) {
                fetch(`/checks/${id}`, {
                    method: 'DELETE'
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('Ошибка при удалении');
                    }
                })
                .catch(err => {
                    alert('Ошибка: ' + err.message);
                });
            }
        }
    </script>
</body>
</html>
