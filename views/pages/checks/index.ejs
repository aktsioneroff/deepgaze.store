<%- include('../../partials/header', { user: user }) %>

<div class="portal-container">
    <%- include('../../partials/sidebar', { user: user, activePage: '/checks', permissions: permissions }) %>
    
    <main class="portal-content">
        <div class="page-header">
            <h1>💳 Чеки</h1>
            <% if (permissions && permissions.checks && permissions.checks.create) { %>
                <a href="/checks/new" class="btn btn-primary">+ Новый чек</a>
            <% } %>
        </div>

        <div class="table-container">
            <table class="table">
                <thead>
                    <tr>
                        <th>№</th>
                        <th>Клиент</th>
                        <th>Телефон</th>
                        <th>Услуга</th>
                        <th>Сумма</th>
                        <th>Статус</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (checks && checks.length > 0) { %>
                        <% checks.forEach((check, index) => { %>
                            <tr>
                                <td>#<%= index + 1 %></td>
                                <td><%= check.clientName || 'Не указан' %></td>
                                <td><%= check.phone || '—' %></td>
                                <td><%= check.serviceName || 'Не указана' %></td>
                                <td><strong><%= (check.amount || 0).toLocaleString() %> ₽</strong></td>
                                <td>
                                    <span class="status-badge status-<%= (check.status || 'черновик').toLowerCase() %>">
                                        <%= check.status || 'Черновик' %>
                                    </span>
                                </td>
                                <td>
                                    <% if (permissions && permissions.checks && permissions.checks.edit) { %>
                                        <a href="/checks/<%= check.id %>/edit" class="btn-icon">✏️</a>
                                    <% } %>
                                    <% if (permissions && permissions.checks && permissions.checks.delete) { %>
                                        <button onclick="deleteCheck('<%= check.id %>')" class="btn-icon danger">🗑️</button>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="7" class="empty-state">
                                <p>Нет созданных чеков</p>
                                <% if (permissions && permissions.checks && permissions.checks.create) { %>
                                    <a href="/checks/new" class="btn btn-primary">Создать первый чек</a>
                                <% } %>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </main>
</div>

<script>
function deleteCheck(id) {
    if (confirm('Удалить этот чек?')) {
        fetch(`/checks/${id}`, { method: 'DELETE' })
            .then(res => res.json())
            .then(data => {
                if (data.success) location.reload();
                else alert('Ошибка');
            });
    }
}
</script>

<%- include('../../partials/footer') %>
