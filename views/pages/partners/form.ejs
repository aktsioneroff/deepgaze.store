<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  
  <link rel="icon" type="image/x-icon" href="/ico/favicon.ico">
  <link rel="apple-touch-icon" href="/ico/apple-touch-icon.png">
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/portal.css">
  <link rel="stylesheet" href="/css/portal-modules.css">
  
  <style>
    .logo-preview {
      width: 120px;
      height: 120px;
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0.5rem 0 1rem 0;
      overflow: hidden;
      transition: all 0.3s ease;
    }
    .logo-preview img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
    .logo-preview .placeholder {
      color: var(--text-muted);
      font-size: 0.8rem;
      text-align: center;
      padding: 1rem;
    }
    .logo-preview .logo-text {
      font-size: 3rem;
      font-weight: 700;
      font-family: 'Space Grotesk', sans-serif;
      color: var(--accent);
    }
    .form-hint {
      font-size: 0.7rem;
      color: var(--text-muted);
      margin-top: 0.3rem;
    }
  </style>
</head>
<body>
  <div class="grid-bg"></div>
  
  <div class="portal-wrapper">
    <%- include('../../partials/sidebar', { activePage: '/partners', user: user }) %>
    
    <main class="portal-main">
      <header class="portal-header">
        <div class="portal-header-left">
          <button class="mobile-sidebar-toggle" onclick="toggleSidebar()" title="Открыть меню">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="3" y1="6" x2="21" y2="6"/>
              <line x1="3" y1="12" x2="21" y2="12"/>
              <line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
          </button>
          <h1>
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.8" style="display:inline-block;vertical-align:middle;margin-right:0.5rem;">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
            <%= isEdit ? 'Редактирование' : 'Добавление' %> партнёра
          </h1>
        </div>
        <div class="portal-header-right">
          <span class="header-date"><%= new Date().toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
        </div>
      </header>
      
      <div class="portal-content">
        <div class="module-form">
          <form action="/partners/save" method="POST">
            <% if (isEdit) { %>
              <input type="hidden" name="id" value="<%= partner.id %>">
            <% } %>
            
            <div class="form-group">
              <label for="name">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="1.8" style="display:inline-block;vertical-align:middle;margin-right:0.3rem;">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                  <circle cx="9" cy="7" r="4"/>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
                Наименование бренда
              </label>
              <input type="text" id="name" name="name" class="form-control" placeholder="Например: OPTIC LAB" value="<%= partner ? partner.name : '' %>" required>
            </div>
            
            <div class="form-group">
              <label for="logo">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="1.8" style="display:inline-block;vertical-align:middle;margin-right:0.3rem;">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21 15 16 10 5 21"/>
                </svg>
                URL логотипа
              </label>
              <input type="url" id="logo" name="logo" class="form-control" placeholder="https://example.com/logo.png" value="<%= partner ? partner.logo : '' %>">
              <div class="form-hint">Вставьте ссылку на изображение логотипа. Логотип автоматически будет стилизован под дизайн сайта.</div>
            </div>
            
            <% if (partner && partner.logo) { %>
              <div class="form-group">
                <label>Предпросмотр логотипа</label>
                <div class="logo-preview">
                  <img src="<%= partner.logo %>" alt="<%= partner.name %>" onerror="this.style.display='none';this.parentElement.innerHTML='<span class=\\'logo-text\\'>'+'<%= partner.name.charAt(0).toUpperCase() %>'+'</span>'">
                </div>
              </div>
            <% } %>
            
            <div class="form-actions">
              <button type="submit" class="btn btn-primary">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:0.3rem;">
                  <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                  <polyline points="17 21 17 13 7 13 7 21"/>
                  <polyline points="7 3 7 8 15 8"/>
                </svg>
                <%= isEdit ? 'Сохранить' : 'Добавить' %>
              </button>
              <a href="/partners" class="btn btn-outline">Отмена</a>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>
  
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const logoInput = document.getElementById('logo');
      if (logoInput) {
        logoInput.addEventListener('input', function() {
          const preview = document.querySelector('.logo-preview');
          if (preview && this.value) {
            preview.innerHTML = '<img src="' + this.value + '" alt="Предпросмотр" onerror="this.style.display=\'none\';this.parentElement.innerHTML=\'<span class=\\'logo-text\\'>?</span>\'">';
          }
        });
      }
    });
  </script>
  
  <script src="/js/portal.js"></script>
</body>
</html>