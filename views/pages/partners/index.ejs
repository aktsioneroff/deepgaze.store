<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  
  <link rel="icon" type="image/x-icon" href="/ico/favicon.ico">
  <link rel="apple-touch-icon" href="/ico/apple-touch-icon.png">
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/portal.css">
  <link rel="stylesheet" href="/css/portal-modules.css">
  
  <style>
    .partner-logo {
      width: 80px;
      height: 80px;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.04);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2rem;
      font-weight: 700;
      font-family: 'Space Grotesk', sans-serif;
      color: var(--accent);
      border: 1px solid var(--border);
      transition: all 0.3s ease;
      overflow: hidden;
    }
    .partner-logo img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
    .partner-logo .logo-text {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--accent);
    }
  </style>
</head>
<body>
  <div class="grid-bg"></div>
  
  <div class="portal-wrapper">
    <%- include('../../partials/sidebar', { activePage: '/partners', user: user }) %>
    
    <main class="portal-main">
      <header class="portal-header">
        <div class="portal-header-left">
          <button class="mobile-sidebar-toggle" onclick="toggleSidebar()" title="Открыть меню">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="3" y1="6" x2="21" y2="6"/>
              <line x1="3" y1="12" x2="21" y2="12"/>
              <line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
          </button>
          <h1>
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.8" style="display:inline-block;vertical-align:middle;margin-right:0.5rem;">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
            Партнёры
          </h1>
        </div>
        <div class="portal-header-right">
          <span class="header-date"><%= new Date().toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
        </div>
      </header>
      
      <div class="portal-content">
        <div class="module-header">
          <h2>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.8">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
            Список партнёров
          </h2>
          <div class="module-actions">
            <a href="/partners/add" class="btn btn-primary">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:0.3rem;">
                <line x1="12" y1="5" x2="12" y2="19"/>
                <line x1="5" y1="12" x2="19" y2="12"/>
              </svg>
              Добавить партнёра
            </a>
          </div>
        </div>
        
        <div class="table-wrapper">
          <% if (partners && partners.length > 0) { %>
            <table>
              <thead>
                <tr>
                  <th>№</th>
                  <th>Логотип</th>
                  <th>Наименование бренда</th>
                  <th>Действия</th>
                </tr>
              </thead>
              <tbody>
                <% partners.forEach(function(partner, index) { %>
                  <tr>
                    <td><span class="table-id"><%= index + 1 %></span></td>
                    <td>
                      <div class="partner-logo">
                        <% if (partner.logo && partner.logo.startsWith('http')) { %>
                          <img src="<%= partner.logo %>" alt="<%= partner.name %>" onerror="this.style.display='none';this.parentElement.innerHTML='<span class=\\'logo-text\\'>'+'<%= partner.name.charAt(0).toUpperCase() %>'+'</span>'">
                        <% } else { %>
                          <span class="logo-text"><%= partner.name.charAt(0).toUpperCase() %></span>
                        <% } %>
                      </div>
                    </td>
                    <td><strong><%= partner.name %></strong></td>
                    <td>
                      <div class="table-actions">
                        <a href="/partners/edit/<%= partner.id %>" class="btn-icon" title="Редактировать">
                          <svg viewBox="0 0 24 24">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                          </svg>
                        </a>
                        <button class="btn-icon danger" onclick="deletePartner('<%= partner.id %>')" title="Удалить">
                          <svg viewBox="0 0 24 24">
                            <polyline points="3 6 5 6 21 6"/>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                          </svg>
                        </button>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } else { %>
            <div class="empty-state">
              <div class="empty-icon">🤝</div>
              <h4>Нет партнёров</h4>
              <p>Добавьте первого партнёра, нажав кнопку «Добавить партнёра»</p>
            </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>
  
  <script>
    function deletePartner(id) {
      if (confirm('Вы уверены, что хотите удалить этого партнёра?')) {
        fetch('/partners/delete/' + id, { method: 'DELETE' })
          .then(res => res.json())
          .then(data => {
            if (data.success) {
              location.reload();
            } else {
              alert('Ошибка удаления');
            }
          })
          .catch(() => alert('Ошибка сервера'));
      }
    }
  </script>
  
  <script src="/js/portal.js"></script>
</body>
</html>