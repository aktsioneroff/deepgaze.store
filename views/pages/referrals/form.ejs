<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  
  <link rel="icon" type="image/x-icon" href="/ico/favicon.ico">
  <link rel="apple-touch-icon" href="/ico/apple-touch-icon.png">
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/portal.css">
  <link rel="stylesheet" href="/css/portal-modules.css">
  
  <style>
    .module-form .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
    @media (max-width: 600px) {
      .module-form .form-row {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <div class="grid-bg"></div>
  
  <div class="portal-wrapper">
    <%- include('../../partials/sidebar', { activePage: '/portal/referrals', user: user }) %>
    
    <main class="portal-main">
      <header class="portal-header">
        <div class="portal-header-left">
          <button class="mobile-sidebar-toggle" onclick="toggleSidebar()" title="Открыть меню">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="3" y1="6" x2="21" y2="6"/>
              <line x1="3" y1="12" x2="21" y2="12"/>
              <line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
          </button>
          <h1>
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.8" style="display:inline-block;vertical-align:middle;margin-right:0.5rem;">
              <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
            </svg>
            <%= isEdit ? 'Редактирование' : 'Добавление' %> клиента
          </h1>
        </div>
        <div class="portal-header-right">
          <span class="header-date"><%= new Date().toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
        </div>
      </header>
      
      <div class="portal-content">
        <div class="module-form">
          <form action="/portal/referrals/save" method="POST">
            <% if (isEdit) { %>
              <input type="hidden" name="id" value="<%= referral.id %>">
            <% } %>
            
            <div class="form-row">
              <div class="form-group">
                <label for="name">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="1.8" style="display:inline-block;vertical-align:middle;margin-right:0.3rem;">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                  </svg>
                  Имя клиента
                </label>
                <input type="text" id="name" name="name" class="form-control" placeholder="Например: Иван Петров" value="<%= referral ? referral.name : '' %>" required>
              </div>
              
              <div class="form-group">
                <label for="phone">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="1.8" style="display:inline-block;vertical-align:middle;margin-right:0.3rem;">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                  </svg>
                  Телефон
                </label>
                <input type="tel" id="phone" name="phone" class="form-control" placeholder="+7 (999) 123-45-67" value="<%= referral ? referral.phone : '' %>" required>
              </div>
            </div>
            
            <div class="form-group">
              <label for="bonus">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="1.8" style="display:inline-block;vertical-align:middle;margin-right:0.3rem;">
                  <circle cx="12" cy="12" r="10"/>
                  <path d="M12 6v6l4 2"/>
                </svg>
                Начальные бонусы
              </label>
              <input type="number" id="bonus" name="bonus" class="form-control" placeholder="0" value="<%= referral ? referral.bonus : 0 %>" min="0">
              <div class="field-hint" style="font-size:0.7rem;color:var(--text-muted);margin-top:0.2rem;">Оставьте 0, если не хотите начислять начальные бонусы</div>
            </div>
            
            <div class="form-actions">
              <button type="submit" class="btn btn-primary">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:0.3rem;">
                  <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                  <polyline points="17 21 17 13 7 13 7 21"/>
                  <polyline points="7 3 7 8 15 8"/>
                </svg>
                <%= isEdit ? 'Сохранить' : 'Добавить' %>
              </button>
              <a href="/portal/referrals" class="btn btn-outline">Отмена</a>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>
  
  <script src="/js/portal.js"></script>
</body>
</html>