<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  
  <link rel="icon" type="image/x-icon" href="/ico/favicon.ico">
  <link rel="apple-touch-icon" href="/ico/apple-touch-icon.png">
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/portal.css">
  <link rel="stylesheet" href="/css/portal-modules.css">
  
  <style>
    .status-select {
      padding: 0.2rem 0.4rem;
      border-radius: 0.3rem;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border);
      color: var(--text);
      font-size: 0.7rem;
      cursor: pointer;
      font-family: 'Inter', sans-serif;
    }
    .status-select:focus {
      outline: none;
      border-color: var(--accent);
    }
    .status-select option {
      background: var(--surface);
      color: var(--text);
    }
  </style>
</head>
<body>
  <div class="grid-bg"></div>
  
  <div class="portal-wrapper">
    <%- include('../../partials/sidebar', { activePage: '/requests', user: user }) %>
    
    <main class="portal-main">
      <header class="portal-header">
        <div class="portal-header-left">
          <button class="mobile-sidebar-toggle" onclick="toggleSidebar()" title="Открыть меню">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="3" y1="6" x2="21" y2="6"/>
              <line x1="3" y1="12" x2="21" y2="12"/>
              <line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
          </button>
          <h1>
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.8" style="display:inline-block;vertical-align:middle;margin-right:0.5rem;">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="16" y1="13" x2="8" y2="13"/>
              <line x1="16" y1="17" x2="8" y2="17"/>
            </svg>
            Заявки
          </h1>
        </div>
        <div class="portal-header-right">
          <span class="header-date"><%= new Date().toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
        </div>
      </header>
      
      <div class="portal-content">
        <div class="module-header">
          <h2>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.8">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="16" y1="13" x2="8" y2="13"/>
              <line x1="16" y1="17" x2="8" y2="17"/>
            </svg>
            Список заявок
          </h2>
          <div class="module-actions">
            <a href="/requests/add" class="btn btn-primary">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:0.3rem;">
                <line x1="12" y1="5" x2="12" y2="19"/>
                <line x1="5" y1="12" x2="19" y2="12"/>
              </svg>
              Добавить заявку
            </a>
          </div>
        </div>
        
        <div class="table-wrapper">
          <% if (requests && requests.length > 0) { %>
            <table>
              <thead>
                <tr>
                  <th>№</th>
                  <th>Имя</th>
                  <th>Телефон</th>
                  <th>Дата и время</th>
                  <th>Услуга</th>
                  <th>Источник</th>
                  <th>Статус</th>
                  <th>Действия</th>
                </tr>
              </thead>
              <tbody>
                <% requests.forEach(function(request, index) { 
                  let statusClass = '';
                  if (request.status === 'Новая') statusClass = 'status-new';
                  else if (request.status === 'В обработке') statusClass = 'status-processing';
                  else if (request.status === 'Завершена') statusClass = 'status-done';
                  else if (request.status === 'Отменена') statusClass = 'status-canceled';
                  
                  let sourceClass = '';
                  if (request.source === 'Сайт') sourceClass = 'source-site';
                  else if (request.source === 'Менеджер') sourceClass = 'source-manager';
                  else if (request.source === 'Телефон') sourceClass = 'source-phone';
                  else if (request.source === 'Соцсети') sourceClass = 'source-social';
                  else if (request.source === 'Рекомендация') sourceClass = 'source-recommendation';
                %>
                  <tr>
                    <td><span class="table-id"><%= index + 1 %></span></td>
                    <td><strong><%= request.name %></strong></td>
                    <td><%= request.phone %></td>
                    <td><%= request.date %> в <%= request.time %></td>
                    <td><%= request.serviceName %></td>
                    <td>
                      <span class="source-badge <%= sourceClass %>">
                        <%= request.source || 'Менеджер' %>
                      </span>
                    </td>
                    <td>
                      <span class="status-badge <%= statusClass %>">
                        <%= request.status %>
                      </span>
                    </td>
                    <td>
                      <div class="table-actions">
                        <a href="/requests/edit/<%= request.id %>" class="btn-icon" title="Редактировать">
                          <svg viewBox="0 0 24 24">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                          </svg>
                        </a>
                        <button class="btn-icon danger" onclick="deleteRequest('<%= request.id %>')" title="Удалить">
                          <svg viewBox="0 0 24 24">
                            <polyline points="3 6 5 6 21 6"/>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                          </svg>
                        </button>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } else { %>
            <div class="empty-state">
              <div class="empty-icon">📋</div>
              <h4>Нет заявок</h4>
              <p>Добавьте первую заявку, нажав кнопку «Добавить заявку»</p>
            </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>
  
  <script>
    function deleteRequest(id) {
      if (confirm('Вы уверены, что хотите удалить эту заявку?')) {
        fetch('/requests/delete/' + id, { method: 'DELETE' })
          .then(res => res.json())
          .then(data => {
            if (data.success) {
              location.reload();
            } else {
              alert('Ошибка удаления');
            }
          })
          .catch(() => alert('Ошибка сервера'));
      }
    }
  </script>
  
  <script src="/js/portal.js"></script>
</body>
</html>