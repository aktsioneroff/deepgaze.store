<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  
  <link rel="icon" type="image/x-icon" href="/ico/favicon.ico">
  <link rel="apple-touch-icon" href="/ico/apple-touch-icon.png">
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/portal.css">
  <link rel="stylesheet" href="/css/portal-modules.css">
  
  <style>
    .module-form .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
    
    @media (max-width: 600px) {
      .module-form .form-row {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <div class="grid-bg"></div>
  
  <div class="portal-wrapper">
    <%- include('../../partials/sidebar', { activePage: '/employees', user: user }) %>
    
    <main class="portal-main">
      <header class="portal-header">
        <div class="portal-header-left">
          <button class="mobile-sidebar-toggle" onclick="toggleSidebar()" title="Открыть меню">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="3" y1="6" x2="21" y2="6"/>
              <line x1="3" y1="12" x2="21" y2="12"/>
              <line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
          </button>
          <h1>
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.8" style="display:inline-block;vertical-align:middle;margin-right:0.5rem;">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
            <%= isEdit ? 'Редактирование' : 'Добавление' %> сотрудника
          </h1>
        </div>
        <div class="portal-header-right">
          <span class="header-date"><%= new Date().toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
        </div>
      </header>
      
      <div class="portal-content">
        <div class="module-form">
          <form action="/employees/save" method="POST">
            <% if (isEdit) { %>
              <input type="hidden" name="id" value="<%= employee.id %>">
            <% } %>
            
            <!-- Основная информация -->
            <div class="form-group">
              <label for="fullName">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="1.8" style="display:inline-block;vertical-align:middle;margin-right:0.3rem;">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                  <circle cx="12" cy="7" r="4"/>
                </svg>
                Ф.И.О.
              </label>
              <input type="text" id="fullName" name="fullName" class="form-control" placeholder="Например: Иванов Иван Иванович" value="<%= employee ? employee.fullName : '' %>" required>
            </div>
            
            <div class="form-row">
              <div class="form-group">
                <label for="birthDate">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="1.8" style="display:inline-block;vertical-align:middle;margin-right:0.3rem;">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                    <line x1="16" y1="2" x2="16" y2="6"/>
                    <line x1="8" y1="2" x2="8" y2="6"/>
                    <line x1="3" y1="10" x2="21" y2="10"/>
                  </svg>
                  Дата рождения
                </label>
                <input type="date" id="birthDate" name="birthDate" class="form-control" value="<%= employee ? employee.birthDate : '' %>">
              </div>
              
              <div class="form-group">
                <label for="phone">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="1.8" style="display:inline-block;vertical-align:middle;margin-right:0.3rem;">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                  </svg>
                  Телефон
                </label>
                <input type="tel" id="phone" name="phone" class="form-control" placeholder="+7 (999) 123-45-67" value="<%= employee ? employee.phone : '' %>">
              </div>
            </div>
            
            <div class="form-row">
              <div class="form-group">
                <label for="position">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="1.8" style="display:inline-block;vertical-align:middle;margin-right:0.3rem;">
                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
                  </svg>
                  Должность
                </label>
<select id="position" name="position" class="form-control" required>
  <option value="">Выберите должность</option>
  <option value="Фотограф, стажер" <%= employee && employee.position === 'Фотограф, стажер' ? 'selected' : '' %>>Фотограф, стажер</option>
  <option value="Фотограф" <%= employee && employee.position === 'Фотограф' ? 'selected' : '' %>>Фотограф</option>
  <option value="Фотограф, старший" <%= employee && employee.position === 'Фотограф, старший' ? 'selected' : '' %>>Фотограф, старший</option>
  <option value="Управляющий" <%= employee && employee.position === 'Управляющий' ? 'selected' : '' %>>Управляющий</option>
  <option value="Директор" <%= employee && employee.position === 'Директор' ? 'selected' : '' %>>Директор</option>
  <% if (isAdmin) { %>
    <option value="Генеральный директор" <%= employee && employee.position === 'Генеральный директор' ? 'selected' : '' %>>Генеральный директор</option>
  <% } %>
</select>
              </div>
              
              <div class="form-group">
                <label for="branchId">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="1.8" style="display:inline-block;vertical-align:middle;margin-right:0.3rem;">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                    <circle cx="12" cy="10" r="3"/>
                  </svg>
                  Филиал (адрес)
                </label>
                <select id="branchId" name="branchId" class="form-control">
                  <option value="">Не указан</option>
                  <% branches.forEach(function(branch) { %>
                    <option value="<%= branch.id %>" <%= employee && employee.branchId === branch.id ? 'selected' : '' %>>
                      <%= branch.address %> (<%= branch.city %>)
                    </option>
                  <% }) %>
                </select>
              </div>
            </div>
            
            <!-- Данные для входа в портал -->
            <div style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border);">
              <h4 style="font-family: 'Space Grotesk', sans-serif; font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.8">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                  <line x1="3" y1="9" x2="21" y2="9"/>
                  <line x1="3" y1="15" x2="21" y2="15"/>
                  <line x1="9" y1="21" x2="9" y2="9"/>
                </svg>
                Данные для входа в портал
              </h4>
              
              <div class="form-row">
                <div class="form-group">
                  <label for="login">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="1.8" style="display:inline-block;vertical-align:middle;margin-right:0.3rem;">
                      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                      <circle cx="12" cy="7" r="4"/>
                    </svg>
                    Логин
                  </label>
                  <input type="text" id="login" name="login" class="form-control" placeholder="Введите логин" value="<%= employee ? employee.login : '' %>">
                  <div class="field-hint" style="font-size:0.7rem;color:var(--text-muted);margin-top:0.2rem;">Оставьте пустым, чтобы не создавать/не менять</div>
                </div>
                
                <div class="form-group">
                  <label for="password">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="1.8" style="display:inline-block;vertical-align:middle;margin-right:0.3rem;">
                      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                      <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                    Пароль
                  </label>
                  <input type="text" id="password" name="password" class="form-control" placeholder="Введите пароль" value="<%= employee ? employee.password : '' %>">
                  <div class="field-hint" style="font-size:0.7rem;color:var(--text-muted);margin-top:0.2rem;">Оставьте пустым, чтобы не менять пароль</div>
                </div>
              </div>
            </div>
            
            <div class="form-actions">
              <button type="submit" class="btn btn-primary">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:0.3rem;">
                  <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                  <polyline points="17 21 17 13 7 13 7 21"/>
                  <polyline points="7 3 7 8 15 8"/>
                </svg>
                <%= isEdit ? 'Сохранить' : 'Добавить' %>
              </button>
              <a href="/employees" class="btn btn-outline">Отмена</a>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>
  
  <script src="/js/portal.js"></script>
</body>
</html>