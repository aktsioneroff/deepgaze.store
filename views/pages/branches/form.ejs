<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  
  <link rel="icon" type="image/x-icon" href="/ico/favicon.ico">
  <link rel="apple-touch-icon" href="/ico/apple-touch-icon.png">
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/portal.css">
  <link rel="stylesheet" href="/css/portal-modules.css">
</head>
<body>
  <div class="grid-bg"></div>
  
  <div class="portal-wrapper">
    <%- include('../../partials/sidebar', { activePage: '/branches', user: user }) %>
    
    <main class="portal-main">
      <header class="portal-header">
        <div class="portal-header-left">
          <button class="mobile-sidebar-toggle" onclick="toggleSidebar()" title="Открыть меню">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="3" y1="6" x2="21" y2="6"/>
              <line x1="3" y1="12" x2="21" y2="12"/>
              <line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
          </button>
          <h1>
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.8" style="display:inline-block;vertical-align:middle;margin-right:0.5rem;">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            <%= isEdit ? 'Редактирование' : 'Добавление' %> филиала
          </h1>
        </div>
        <div class="portal-header-right">
          <span class="header-date"><%= new Date().toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
        </div>
      </header>
      
      <div class="portal-content">
        <div class="module-form">
          <form action="/branches/save" method="POST">
            <% if (isEdit) { %>
              <input type="hidden" name="id" value="<%= branch.id %>">
            <% } %>
            
            <div class="form-group">
              <label for="city">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="1.8" style="display:inline-block;vertical-align:middle;margin-right:0.3rem;">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
                Город
              </label>
              <input type="text" id="city" name="city" class="form-control" placeholder="Например: Москва" value="<%= branch ? branch.city : '' %>" required>
            </div>
            
            <div class="form-group">
              <label for="address">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="1.8" style="display:inline-block;vertical-align:middle;margin-right:0.3rem;">
                  <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                  <path d="M2 17l10 5 10-5"/>
                  <path d="M2 12l10 5 10-5"/>
                </svg>
                Адрес
              </label>
              <input type="text" id="address" name="address" class="form-control" placeholder="Например: ул. Тверская, 1" value="<%= branch ? branch.address : '' %>" required>
            </div>
            
            <div class="form-group">
              <label for="rent">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="1.8" style="display:inline-block;vertical-align:middle;margin-right:0.3rem;">
                  <circle cx="12" cy="12" r="10"/>
                  <path d="M12 6v6l4 2"/>
                </svg>
                Стоимость аренды (₽)
              </label>
              <input type="number" id="rent" name="rent" class="form-control" placeholder="Например: 50000" value="<%= branch ? branch.rent : '' %>" required>
            </div>
            
            <div class="form-group">
              <label for="rentDate">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="1.8" style="display:inline-block;vertical-align:middle;margin-right:0.3rem;">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                  <line x1="16" y1="2" x2="16" y2="6"/>
                  <line x1="8" y1="2" x2="8" y2="6"/>
                  <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
                Дата аренды
              </label>
              <input type="date" id="rentDate" name="rentDate" class="form-control" value="<%= branch ? branch.rentDate : '' %>">
            </div>
            
            <div class="form-actions">
              <button type="submit" class="btn btn-primary">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:0.3rem;">
                  <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                  <polyline points="17 21 17 13 7 13 7 21"/>
                  <polyline points="7 3 7 8 15 8"/>
                </svg>
                <%= isEdit ? 'Сохранить' : 'Добавить' %>
              </button>
              <a href="/branches" class="btn btn-outline">Отмена</a>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>
  
  <script src="/js/portal.js"></script>
</body>
</html>